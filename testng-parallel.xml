<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="All Test Suite" parallel="classes" thread-count="4">
    <listeners>
        <listener class-name="io.learn.Listener.TestListener"/>
    </listeners>
    <test name="Regression suite - parallel Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="io.learn.AppTest.LoginTest"/>
	        <class name="io.learn.AppTest.Logout"/>
	        <class name="io.learn.AppTest.ProductTest"/>
	        <class name="io.learn.AppTest.CartTest"/>
        </classes>
    </test>
</suite>